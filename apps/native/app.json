{
  "expo": {
    "scheme": "usi-installer",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "usi-installer",
    "slug": "usi-installer",
    "android": {
      "edgeToEdgeEnabled": true,
      "backgroundColor": "#8AAAFA",
      "package": "com.slidingscale.usiinstaller"
    },
    "plugins": [
      "expo-font",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.slidingscale.usiinstaller"
    }
  }
}
