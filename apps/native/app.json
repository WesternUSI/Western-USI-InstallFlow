{
  "expo": {
    "scheme": "usi-installer",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "Western USI Installer",
    "slug": "usi-installer",
    "icon": "./assets/images/icon.png",
    "android": {
      "edgeToEdgeEnabled": true,
      "backgroundColor": "#8AAAFA",
      "package": "com.slidingscale.usiinstaller",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take install completion photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to optimize the install route."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.slidingscale.usiinstaller",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Allow $(PRODUCT_NAME) to use motion data to improve the accuracy of your location while optimizing the install route."
      }
    },
    "extra": {
      "eas": {
        "projectId": "a265d00b-dc06-4936-ac08-025df51d8b76"
      }
    },
    "owner": "western-usi"
  }
}
